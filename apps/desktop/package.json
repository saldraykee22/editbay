{
  "name": "@editbay/desktop",
  "productName": "Editbay",
  "version": "0.1.0",
  "description": "Editbay — the AI cutting room for brands.",
  "author": "Alper and Editbay contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@editbay/core": "workspace:*",
    "@editbay/effects": "workspace:*",
    "@editbay/engine": "workspace:*",
    "@editbay/harness": "workspace:*",
    "@editbay/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "app.editbay.desktop",
    "productName": "Editbay",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "extraResources": [
      { "from": "resources/skills", "to": "skills" },
      { "from": "resources/fonts", "to": "fonts" }
    ],
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"], "category": "public.app-category.video" },
    "linux": { "target": ["AppImage"], "category": "AudioVideo" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
